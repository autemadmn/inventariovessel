{
  "name": "inventario-vessel",
  "version": "0.1.0",
  "private": true,
  "description": "Reposición de botellas en las barras: listas compartidas, historial, previsión y lista de compra.",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "postgres": "^3.4.9"
  }
}
