// Configuración de Cloudflare Workers. Se despliega con `npx wrangler deploy`
// o automáticamente desde el panel de Cloudflare conectando este repositorio.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reposicion-barras",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  // Base de datos. Al desplegar por primera vez, Cloudflare la crea sola.
  "d1_databases": [
    { "binding": "DB", "database_name": "reposicion-barras" }
  ],
  "observability": { "enabled": true }
  // STAFF_CODE y MANAGER_PIN se añaden como secretos en el panel de Cloudflare
  // (Worker → Settings → Variables and Secrets), nunca en este archivo.
}
