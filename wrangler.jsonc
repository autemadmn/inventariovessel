// Configuración de Cloudflare Workers. Se despliega con `npx wrangler deploy`
// o automáticamente desde el panel de Cloudflare conectando este repositorio.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reposicion-barras",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  // postgres.js necesita los módulos de Node (sockets, crypto, buffer).
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DATABASE_SCHEMA": "vessel_reposicion" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  "observability": { "enabled": true }
  // La base de datos es Postgres en Supabase (ver README, «Pasar a Supabase»).
  // STAFF_CODE, MANAGER_PIN y DATABASE_URL se añaden como secretos
  // (`npx wrangler secret put DATABASE_URL` o en el panel de Cloudflare:
  // Worker → Settings → Variables and Secrets), nunca en este archivo.
}
